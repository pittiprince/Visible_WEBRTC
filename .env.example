# Visible — Environment Variables
# Copy to .env and fill in actual values. Never commit .env itself.

# WebRTC Signaling Server
VITE_SIGNALING_SERVER_URL=ws://localhost:3001

# STUN/TURN (use public STUN for development; TURN needed for production NAT traversal)
VITE_STUN_URL=stun:stun.l.google.com:19302
# VITE_TURN_URL=
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# Application
VITE_APP_TITLE=Visible
VITE_APP_ENV=development
